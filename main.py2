def calculate_factorial(n):
    """
    Рекурсивна функція для обчислення факторіалу.
    Використовується для демонстрації математичних можливостей сервісу.
    """
    # Перевірка на від'ємні числа
    if n < 0:
        return "Помилка: Факторіал не визначений для від'ємних чисел."
    
    # Базовий випадок (0! = 1 та 1! = 1)
    if n == 0 or n == 1:
        return 1
    
    # Рекурсивний крок: n! = n * (n-1)!
    return n * calculate_factorial(n - 1)

# Приклад інтеграції в логіку AnswerBetter:
def demo_math_feature():
    print("\n--- Додатковий модуль: Математична обробка ---")
    try:
        num = int(input("Введіть число для розрахунку факторіалу: "))
        result = calculate_factorial(num)
        
        # "The Why Factor" для математики
        print(f"Результат: {result}")
        print("💡 Психологічний ефект: Використання точних цифр у повідомленнях "
              "підвищує рівень довіри до ваших аргументів на 40%.")
    except ValueError:
        print("Помилка: будь ласка, введіть ціле число.")

if __name__ == "__main__":
    # Виклик демо-функції
    demo_math_feature()
